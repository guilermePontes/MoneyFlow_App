<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 🌸 Cabeçalho arredondado com botão de voltar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_header"
        android:padding="16dp">

        <!-- 🔙 Botão voltar -->
        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/ic_arrow_back" <!-- <- aqui vai o ícone de seta -->
        android:contentDescription="Voltar" />

        <!-- 📝 Título central -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notificações"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- 🌥️ Conteúdo central com nuvens -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ☁️ Nuvem de cima -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:src="@drawable/cloud1"
            android:layout_marginBottom="8dp"/>

        <!-- Texto central -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhuma atualização :("
            android:textColor="#B0B0B0"
            android:textSize="16sp" />

        <!-- ☁️ Nuvem de baixo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:src="@drawable/cloud2"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
